
<?xml version="1.0" encoding="utf-8"?>
<jnlp spec="1.0+" codebase="https://<IMM_IP>:443">
 <information>
   <title>Virtual KVM Client</title>
    <vendor>IBM</vendor>
 </information>
 
 <application-desc main-class="com.avocent.ibmc.kvm.Main">
	  <argument>ip=<IMM_IP></argument>
    <argument>kmport=3900</argument>
    <argument>vport=3900</argument>
	  <argument>user=0x00000000</argument>
	  <argument>passwd=</argument>
    <argument>title=<IMM_IP>-Video Viewer</argument>
    <argument>immversion=2</argument>
    <argument>vm=1</argument>
    <argument>apcp=1</argument>
    <argument>color=2</argument>
    <argument>language=en</argument>
    <argument>power=1</argument>
    <argument>reconnect=2</argument>
    <argument>smfs=1</argument>
    <argument>dvr=2</argument>
    <argument>webuser=0</argument>
    <argument>export=1</argument>
	  <argument>help=https://<IMM_IP>:443/designs/imm/aessrp/help/contents.html</argument>
	  <argument>statusbar=un,ip,pwr,fr,kp,bw,led,enc</argument>
  </application-desc>
 
 <security>
  <all-permissions/>
 </security>
 
 <update check="always" policy="always" />
 
 <resources>
    <j2se version="1.6+ 1.5+ " />
    <jar href="/designs/imm/aessrp/avctIBMViewer__V030321.jar" download="eager" main="true" />
 </resources>
 
